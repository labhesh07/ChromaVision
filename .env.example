# Copy to .env and adjust if needed.

# cuda | cpu — falls back to cpu if CUDA unavailable
DEVICE=cuda

# Max upload size (MB)
MAX_UPLOAD_MB=20

# Longest image edge (px) before ML models run (saves VRAM)
MAX_INPUT_EDGE=2048

# Optional: absolute paths to weights (defaults: ./weights/…)
# REALESRGAN_WEIGHTS=weights/realesr-general-x4v3.pth
# REALESRGAN_X4PLUS_WEIGHTS=weights/RealESRGAN_x4plus.pth
# GFPGAN_WEIGHTS=weights/GFPGANv1.4.pth
# COLORIZE_PROTOTXT=weights/colorization_deploy_v2.prototxt
# COLORIZE_PRIMARY_WEIGHTS=weights/colorization_release_v2.caffemodel
# COLORIZE_FALLBACK_WEIGHTS=weights/colorization_release_v2_norebal.caffemodel
# COLORIZE_PTS=weights/pts_in_hull.npy

# Model profile:
# - general_x4v3 (faster)
# - x4plus (higher-quality textures, slower/heavier)
REALESRGAN_MODEL=general_x4v3

# Tile settings (0 disables tiling and may use max_input_edge downscale fallback)
REALESRGAN_TILE=400
REALESRGAN_TILE_PAD=10
REALESRGAN_PRE_PAD=0

# Restore pipeline controls
RESTORE_UPSCALE=2
RESTORE_DENOISE=true
DENOISE_STRENGTH=7
DENOISE_COLOR_STRENGTH=7

# Separate advanced upscale/restore profile
ADVANCED_UPSCALE_FACTOR=10
ADVANCED_TILE=400
ADVANCED_TILE_PAD=10
ADVANCED_PRE_PAD=0
ADVANCED_DENOISE=true
ADVANCED_DENOISE_STRENGTH=7
ADVANCED_DENOISE_COLOR_STRENGTH=7

# Colorization dual-model controls
COLORIZE_FALLBACK_ENABLED=true
COLORIZE_FORCE_FALLBACK=false
COLORIZE_PRO_ONLY=true

# Optional post-enhancement chain after colorization
COLORIZE_APPLY_RESTORE=true
# none | upscale | advanced
COLORIZE_POST_UPSCALE_MODE=advanced

# PyTorch CUDA: install torch+torchvision from https://pytorch.org for your CUDA version.
# If basicsr fails to import, ensure torchvision is recent; this project applies a small shim.
